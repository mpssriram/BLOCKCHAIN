# Local development .env example
# Copy this file to .env and fill values, or set environment variables before running dev_all.py

# Database (SQLite local dev)
DATABASE_URL=sqlite:///./blockchain.db

# Secret used for signing backend JWTs (change in production)
SECRET_KEY=local-dev-secret

# Comma-separated allowed origins for CORS (vite dev servers)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# Firebase Admin (required for /api/firebase-login after client sign-in)
# Easiest for local dev: download the key from Firebase Console → Project settings
# → Service accounts → Generate new private key, save as Backend/firebase-service-account.json
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
#
# Alternative (e.g. production): paste JSON or base64 into FIREBASE_SERVICE_ACCOUNT_JSON
# FIREBASE_SERVICE_ACCOUNT_JSON=
APP_ENV=production
ENABLE_DEMO_SEED=false
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
SECRET_KEY=replace-this-in-production
HELA_RPC_URL=https://testnet-rpc.helachain.com
CONTRACT_ADDRESS=0xYOUR_DEPLOYED_CONTRACT
TAX_VAULT_ADDRESS=0xYOUR_TAX_VAULT
TAX_RATE=10
ALLOWED_ORIGINS=https://your-frontend-domain.onrender.com,https://your-employee-frontend.vercel.app
