# Local database and application security
APP_ENV=development
DATABASE_URL=sqlite:///./blockchain.db
SECRET_KEY=replace-with-a-random-value-at-least-32-characters-long
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://127.0.0.1:5174
ENABLE_DEMO_SEED=false

# Public URL used in password-reset links
FRONTEND_URL=http://localhost:5173

# SMTP account used to deliver password-reset emails
SMTP_SERVER=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=payroll@example.com
SMTP_PASSWORD=replace-with-your-smtp-password
