# Backend environment example for local development or deployment

# Database connection
DATABASE_URL=sqlite:///./blockchain.db

# JWT / app security
SECRET_KEY=replace-this-in-production
APP_ENV=production

# Chain connectivity
HELA_RPC_URL=https://testnet-rpc.helachain.com
CONTRACT_ADDRESS=0xYOUR_DEPLOYED_CONTRACT
TAX_VAULT_ADDRESS=0xYOUR_TAX_VAULT
TAX_RATE=10

# CORS
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# Firebase Admin
# Prefer a file path in local development:
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
#
# Or provide the raw JSON/base64 in production:
# FIREBASE_SERVICE_ACCOUNT_JSON=

# Demo/test data
# Keep false for normal and production deployments.
ENABLE_DEMO_SEED=false
