# Employer frontend environment example

# Backend API base. Leave blank for local Vite proxy usage.
VITE_API_BASE=

# Employee portal URL
VITE_EMPLOYEE_PORTAL_URL=http://localhost:5174/employee/

# Streamlit employer dashboard URL
VITE_STREAMLIT_DASHBOARD_URL=http://127.0.0.1:8501

# Firebase web configuration
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Web3Auth
VITE_WEB3AUTH_CLIENT_ID=YOUR_WEB3AUTH_CLIENT_ID

# HeLa network
VITE_HELA_RPC_URL=https://testnet-rpc.helachain.com
VITE_HELA_CHAIN_ID=0xA2D18
VITE_HELA_EXPLORER_ADDRESS=https://testnet-blockexplorer.helachain.com/address/
VITE_HELA_EXPLORER_TX=https://testnet-blockexplorer.helachain.com/tx/

# Demo login mode
# Keep false for normal and production deployments.
VITE_ENABLE_DEMO_LOGIN=false
VITE_DEMO_EMPLOYER_EMAIL=
VITE_DEMO_EMPLOYER_PASSWORD=
VITE_DEMO_EMPLOYEE_EMAIL=
VITE_DEMO_EMPLOYEE_PASSWORD=
